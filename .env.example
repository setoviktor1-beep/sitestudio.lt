# --- Database ---
# PostgreSQL connection string. Local dev example below; on Coolify the
# compose file builds it from POSTGRES_PASSWORD and the internal `db` host.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/app"

# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
# Public base URL of the app (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"
# Only needed if the app is accessed from a different origin than it serves
# (usually leave unset):
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- SMTP (email verification + password reset) ---
# If SMTP_HOST is empty, emails are printed to the server console instead
# (useful for local development).
SMTP_HOST=""
SMTP_PORT="587"
# "true" for implicit TLS (port 465), "false" for STARTTLS (port 587)
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="My App <no-reply@example.com>"

# --- S3-compatible storage (OPTIONAL — profile picture uploads) ---
# Leave S3_BUCKET empty to disable the /api/upload/avatar endpoint.
# For AWS S3 leave S3_ENDPOINT empty; set it for MinIO / Cloudflare R2 / etc.
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL of the bucket (or CDN in front of it), no trailing slash.
S3_PUBLIC_URL=""

# --- Compose-only (not read by the app itself) ---
# Password for the postgres container in docker-compose.yml.
POSTGRES_PASSWORD="change-me-too"
