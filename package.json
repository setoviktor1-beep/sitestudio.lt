{
  "name": "web-app-template",
  "version": "0.1.0",
  "private": true,
  "description": "Production-ready Next.js + Better Auth + PostgreSQL web application template for Coolify deployments.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "auth:generate": "better-auth generate --config lib/auth.ts --output migrations/000_better_auth.sql",
    "auth:migrate": "better-auth migrate --config lib/auth.ts",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.940.0",
    "better-auth": "^1.6.25",
    "next": "^15.5.0",
    "nodemailer": "^7.0.5",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0"
  }
}
